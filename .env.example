# ===================================================================
# DBS-Express SMTP Configuration
# Set these variables in your Vercel Project Settings > Environment Variables
# or in a local .env file.
# ===================================================================

# SMTP server hostname (e.g., smtp.gmail.com, smtp-relay.brevo.com, smtp.sendgrid.net, mail.yourdomain.com)
SMTP_HOST=smtp.gmail.com

# SMTP server port (usually 587 for TLS or 465 for SSL)
SMTP_PORT=587

# Set to true if using SSL port 465, or false if using TLS port 587
SMTP_SECURE=false

# SMTP username / authentication email
SMTP_USER=contact@dbs-express.co.uk

# SMTP password / App Password (e.g. Gmail 16-character App Password)
SMTP_PASS=your-smtp-password-or-app-password

# Sender address shown in the "From" header
SMTP_FROM="DBS-Express Enquiries" <contact@dbs-express.co.uk>

# Destination email where customer enquiries are delivered
CLIENT_EMAIL=contact@dbs-express.co.uk

